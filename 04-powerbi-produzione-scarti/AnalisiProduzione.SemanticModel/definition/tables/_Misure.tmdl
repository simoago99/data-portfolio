	measure '% Scarto Periodo' = DIVIDE ( [Scarto Kg Periodo], [Consumo Kg Periodo] )
		formatString: 0.00%
		displayFolder: 2. Confronto anno precedente
		lineageTag: 05397e0e-aed1-5505-8666-de5b2d9d7cd8

	measure '% Scarto AP' = DIVIDE ( [Scarto Kg Periodo AP], [Consumo Kg Periodo AP] )
		formatString: 0.00%
		displayFolder: 2. Confronto anno precedente
		lineageTag: f2deb377-a89b-5bc6-8ae4-43e662170610

	/// Negativo = lo scarto è diminuito rispetto allo stesso periodo dell'anno precedente.
	measure 'Delta Scarto (punti %)' = IF ( NOT ISBLANK ( [% Scarto AP] ), [% Scarto Periodo] - [% Scarto AP] )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 2. Confronto anno precedente
		lineageTag: f8fa1526-7230-53b7-b3f6-507b65dfd1ec

	/// Obiettivo di scarto scelto con lo slicer (default 4%).
	measure 'Target Scarto %' = SELECTEDVALUE ( 'Target Scarto'[Target], 0.04 )
		formatString: 0.00%
		displayFolder: 3. Target
		lineageTag: 66880adc-51a1-595e-a4f6-f6882ec237d3

	/// Chili di scarto in eccesso rispetto al target, calcolati linea per linea (le linee sotto target non compensano le altre).
	measure 'Scarto Oltre Target Kg' =
			SUMX (
				VALUES ( Produzione[Linea] ),
				MAX ( 0, [Scarto Kg] - [Consumo Kg] * [Target Scarto %] )
			)
		formatString: #,0
		displayFolder: 3. Target
		lineageTag: d46e7066-db4e-5a1c-96ab-3de04b6996bd

	measure 'Stato vs Target' =
			SWITCH (
				TRUE (),
				ISBLANK ( [% Scarto] ), BLANK (),
				[% Scarto] <= [Target Scarto %], "Entro target",
				[% Scarto] <= [Target Scarto %] * 1.25, "Attenzione",
				"Fuori target"
			)
		displayFolder: 3. Target
		lineageTag: 929c4ded-a4cf-5dc5-bd85-b35935713b57

