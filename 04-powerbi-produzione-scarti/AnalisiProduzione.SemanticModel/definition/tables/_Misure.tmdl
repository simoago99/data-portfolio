		formatString: #,0
		displayFolder: 2. Confronto anno precedente
		lineageTag: 49da3b3a-0e1c-5ec4-909c-72e9c999e7a9

	measure 'Scarto Kg Periodo AP' =
			VAR Rif = [Data Riferimento]
			VAR FiltroData =
				ISFILTERED ( Calendario[Data] ) || ISFILTERED ( Calendario[Anno] ) || ISFILTERED ( Calendario[Mese] )
					|| ISFILTERED ( Calendario[Anno Mese] ) || ISFILTERED ( Calendario[Settimana] )
			VAR Inizio = IF ( FiltroData, MIN ( Calendario[Data] ), DATE ( YEAR ( Rif ), 1, 1 ) )
			VAR Fine = IF ( FiltroData, MIN ( MAX ( Calendario[Data] ), Rif ), Rif )
			RETURN
				CALCULATE ( [Scarto Kg], DATESBETWEEN ( Calendario[Data], EDATE ( Inizio, -12 ), EDATE ( Fine, -12 ) ) )
		formatString: #,0
		displayFolder: 2. Confronto anno precedente
		lineageTag: d2aa300c-52c5-5c5e-8099-b361e4911c19

	measure 'Consumo Kg Periodo AP' =
			VAR Rif = [Data Riferimento]
			VAR FiltroData =
				ISFILTERED ( Calendario[Data] ) || ISFILTERED ( Calendario[Anno] ) || ISFILTERED ( Calendario[Mese] )
					|| ISFILTERED ( Calendario[Anno Mese] ) || ISFILTERED ( Calendario[Settimana] )
			VAR Inizio = IF ( FiltroData, MIN ( Calendario[Data] ), DATE ( YEAR ( Rif ), 1, 1 ) )
			VAR Fine = IF ( FiltroData, MIN ( MAX ( Calendario[Data] ), Rif ), Rif )
			RETURN
				CALCULATE ( [Consumo Kg], DATESBETWEEN ( Calendario[Data], EDATE ( Inizio, -12 ), EDATE ( Fine, -12 ) ) )
