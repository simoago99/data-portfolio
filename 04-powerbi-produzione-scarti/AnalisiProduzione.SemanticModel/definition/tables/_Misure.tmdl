	measure 'Scarto Kg Periodo' =
			VAR Rif = [Data Riferimento]
			VAR FiltroData =
				ISFILTERED ( Calendario[Data] ) || ISFILTERED ( Calendario[Anno] ) || ISFILTERED ( Calendario[Mese] )
					|| ISFILTERED ( Calendario[Anno Mese] ) || ISFILTERED ( Calendario[Settimana] )
			VAR Inizio = IF ( FiltroData, MIN ( Calendario[Data] ), DATE ( YEAR ( Rif ), 1, 1 ) )
			VAR Fine = IF ( FiltroData, MIN ( MAX ( Calendario[Data] ), Rif ), Rif )
			RETURN
				CALCULATE ( [Scarto Kg], DATESBETWEEN ( Calendario[Data], EDATE ( Inizio, 0 ), EDATE ( Fine, 0 ) ) )
		formatString: #,0
		displayFolder: 2. Confronto anno precedente
		lineageTag: cc332e2f-8b2a-5819-a625-e3c93cd41c82

	measure 'Consumo Kg Periodo' =
			VAR Rif = [Data Riferimento]
			VAR FiltroData =
				ISFILTERED ( Calendario[Data] ) || ISFILTERED ( Calendario[Anno] ) || ISFILTERED ( Calendario[Mese] )
					|| ISFILTERED ( Calendario[Anno Mese] ) || ISFILTERED ( Calendario[Settimana] )
			VAR Inizio = IF ( FiltroData, MIN ( Calendario[Data] ), DATE ( YEAR ( Rif ), 1, 1 ) )
			VAR Fine = IF ( FiltroData, MIN ( MAX ( Calendario[Data] ), Rif ), Rif )
			RETURN
