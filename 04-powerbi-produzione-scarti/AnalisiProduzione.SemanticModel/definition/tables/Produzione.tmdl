	partition Produzione = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "produzione.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Data", type date}, {"Ordine Produzione", type text}, {"Linea", type text}, {"Turno", type text}, {"Codice Articolo", type text}, {"Ore Lavorate", type number}, {"Consumo Kg", type number}, {"Produzione Kg", type number}, {"Scarto Kg", type number}, {"Rifili Kg", type number}, {"Metri Quadri", type number}, {"Bobine OK", Int64.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
