	partition Acquisti = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "acquisti.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Data Documento", type date}, {"Numero Documento", type text}, {"Tipo Movimento", type text}, {"Codice Fornitore", type text}, {"Codice Articolo", type text}, {"Quantita", Int64.Type}, {"Costo Totale", Currency.Type}, {"Listino Totale", Currency.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
