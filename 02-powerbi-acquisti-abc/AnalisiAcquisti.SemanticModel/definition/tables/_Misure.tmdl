				)
			VAR Cumulato = SUMX ( FILTER ( Elenco, [@Valore] >= Valore ), [@Valore] )
			VAR Totale = SUMX ( Elenco, [@Valore] )
			RETURN
				IF ( NOT ISBLANK ( Valore ), DIVIDE ( Cumulato, Totale ) )
		formatString: 0.0%
		displayFolder: 2. Analisi ABC
		lineageTag: 40c643bc-a2ff-5d0d-bf47-722569a64a3d

	measure 'Classe ABC Famiglia' =
			VAR Quota = [Quota Cumulata Famiglia %]
			RETURN
				SWITCH ( TRUE (), ISBLANK ( Quota ), BLANK (), Quota <= 0.80, "A", Quota <= 0.95, "B", "C" )
		displayFolder: 2. Analisi ABC
		lineageTag: ac551f72-df03-5a45-8b27-38c25d60ba55

	measure 'Quota Cumulata Fornitore %' =
			VAR Valore = [Costo Acquisto]
			VAR Elenco =
				FILTER (
					CALCULATETABLE (
						ADDCOLUMNS ( VALUES ( Fornitori[Fornitore] ), "@Valore", [Costo Acquisto] ),
						ALLSELECTED ( Fornitori )
					),
					NOT ISBLANK ( [@Valore] )
				)
			VAR Cumulato = SUMX ( FILTER ( Elenco, [@Valore] >= Valore ), [@Valore] )
			VAR Totale = SUMX ( Elenco, [@Valore] )
			RETURN
				IF ( NOT ISBLANK ( Valore ), DIVIDE ( Cumulato, Totale ) )
		formatString: 0.0%
		displayFolder: 2. Analisi ABC
		lineageTag: fd4047da-07fa-5df4-8501-4735a745124d

	measure 'Classe ABC Fornitore' =
			VAR Quota = [Quota Cumulata Fornitore %]
			RETURN
				SWITCH ( TRUE (), ISBLANK ( Quota ), BLANK (), Quota <= 0.80, "A", Quota <= 0.95, "B", "C" )
		displayFolder: 2. Analisi ABC
		lineageTag: 1ad5a518-7141-58a5-841f-c9e38f9d3128

	measure 'Articoli in Classe A' =
			COUNTROWS (
				FILTER ( VALUES ( Articoli[Descrizione] ), [Classe ABC Articolo] = "A" )
			)
		formatString: #,0
		displayFolder: 2. Analisi ABC
		lineageTag: 5a185c3a-075a-5947-bd7a-0c2937c7dfbf

	/// Segnala i casi da verificare con l'ufficio acquisti.
	measure 'Stato Confronto Listino' =
			SWITCH (
				TRUE (),
				ISBLANK ( [Costo Acquisto] ), BLANK (),
				ISBLANK ( [Valore a Listino] ), "Listino mancante",
				[Costo Acquisto] > [Valore a Listino], "Costo sopra listino",
				"In linea con il listino"
			)
		displayFolder: 3. Controlli
		lineageTag: ddd9c0e3-7b14-51e7-90d6-fc5a0d0c40f1

	measure 'Righe senza Listino' = CALCULATE ( COUNTROWS ( Acquisti ), ISBLANK ( Acquisti[Listino Totale] ) )
		formatString: #,0
		displayFolder: 3. Controlli
		lineageTag: 79d81391-c51b-5b0b-a1af-52af123c1a36

	column Colonna
