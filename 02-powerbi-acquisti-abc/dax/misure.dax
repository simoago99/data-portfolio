-- Misure DAX del progetto "Analisi acquisti e classificazione ABC"
-- Generato dal modello semantico: AnalisiAcquisti.SemanticModel/definition/tables/_Misure.tmdl


-- ==================== 0. Base ====================

-- Ultima data di carico presente nei dati.
[Data Riferimento] =
    CALCULATE ( MAX ( Acquisti[Data Documento] ), REMOVEFILTERS () )

[Costo Acquisto] =
    SUM ( Acquisti[Costo Totale] )

[Quantità Acquistata] =
    SUM ( Acquisti[Quantita] )

-- Valore dei carichi al listino di riferimento del fornitore.
[Valore a Listino] =
    SUM ( Acquisti[Listino Totale] )

-- Positivo = abbiamo pagato meno del listino.
[Risparmio vs Listino] =
    [Valore a Listino] - [Costo Acquisto]

[Risparmio % vs Listino] =
    DIVIDE ( [Risparmio vs Listino], [Valore a Listino] )

[Prezzo Medio di Carico] =
    DIVIDE ( [Costo Acquisto], [Quantità Acquistata] )

[Numero Articoli] =
    DISTINCTCOUNT ( Acquisti[Codice Articolo] )

[Numero Fornitori] =
    DISTINCTCOUNT ( Acquisti[Codice Fornitore] )

-- I carichi da fornitore si contano per numero documento; i carichi interni (senza numero)
-- si contano come combinazione unica di data e fornitore.
[Numero Documenti] =
    VAR DocumentiFornitore =
        CALCULATE ( DISTINCTCOUNT ( Acquisti[Numero Documento] ), NOT ISBLANK ( Acquisti[Numero Documento] ) )
    VAR CarichiInterni =
        COUNTROWS (
            SUMMARIZE (
                FILTER ( Acquisti, ISBLANK ( Acquisti[Numero Documento] ) ),
                Acquisti[Data Documento],
                Acquisti[Codice Fornitore]
            )
        )
    RETURN
        DocumentiFornitore + CarichiInterni


-- ==================== 1. Confronto anno precedente ====================

-- Da inizio anno alla data di riferimento (o alla fine del periodo filtrato).
[Costo YTD] =
    VAR Fine = MIN ( MAX ( Calendario[Data] ), [Data Riferimento] )
    VAR FineCalcolo = EDATE ( Fine, 0 )
    RETURN
        CALCULATE (
            [Costo Acquisto],
            DATESBETWEEN ( Calendario[Data], DATE ( YEAR ( FineCalcolo ), 1, 1 ), FineCalcolo )
        )

[Costo YTD AP] =
    VAR Fine = MIN ( MAX ( Calendario[Data] ), [Data Riferimento] )
    VAR FineCalcolo = EDATE ( Fine, -12 )
    RETURN
        CALCULATE (
            [Costo Acquisto],
            DATESBETWEEN ( Calendario[Data], DATE ( YEAR ( FineCalcolo ), 1, 1 ), FineCalcolo )
        )

[Var % Costo YTD] =
    DIVIDE ( [Costo YTD] - [Costo YTD AP], [Costo YTD AP] )

[Quantità YTD] =
    VAR Fine = MIN ( MAX ( Calendario[Data] ), [Data Riferimento] )
    VAR FineCalcolo = EDATE ( Fine, 0 )
    RETURN
        CALCULATE (
            [Quantità Acquistata],
            DATESBETWEEN ( Calendario[Data], DATE ( YEAR ( FineCalcolo ), 1, 1 ), FineCalcolo )
        )

[Quantità YTD AP] =
    VAR Fine = MIN ( MAX ( Calendario[Data] ), [Data Riferimento] )
    VAR FineCalcolo = EDATE ( Fine, -12 )
    RETURN
        CALCULATE (
            [Quantità Acquistata],
            DATESBETWEEN ( Calendario[Data], DATE ( YEAR ( FineCalcolo ), 1, 1 ), FineCalcolo )
        )

[Prezzo Medio YTD] =
    DIVIDE ( [Costo YTD], [Quantità YTD] )

[Prezzo Medio YTD AP] =
    DIVIDE ( [Costo YTD AP], [Quantità YTD AP] )

-- Inflazione dei prezzi d'acquisto: variazione del costo unitario medio rispetto all'anno precedente.
[Var % Prezzo Medio] =
    DIVIDE ( [Prezzo Medio YTD] - [Prezzo Medio YTD AP], [Prezzo Medio YTD AP] )


-- ==================== 2. Analisi ABC ====================

[Quota Cumulata Articolo %] =
    VAR Valore = [Costo Acquisto]
    VAR Elenco =
        FILTER (
            CALCULATETABLE (
                ADDCOLUMNS ( VALUES ( Articoli[Descrizione] ), "@Valore", [Costo Acquisto] ),
                ALLSELECTED ( Articoli )
            ),
            NOT ISBLANK ( [@Valore] )
        )
    VAR Cumulato = SUMX ( FILTER ( Elenco, [@Valore] >= Valore ), [@Valore] )
    VAR Totale = SUMX ( Elenco, [@Valore] )
    RETURN
        IF ( NOT ISBLANK ( Valore ), DIVIDE ( Cumulato, Totale ) )

-- A = articoli che pesano l'80% della spesa, B = fino al 95%, C = il resto.
[Classe ABC Articolo] =
    VAR Quota = [Quota Cumulata Articolo %]
    RETURN
        SWITCH ( TRUE (), ISBLANK ( Quota ), BLANK (), Quota <= 0.80, "A", Quota <= 0.95, "B", "C" )

[Quota Cumulata Famiglia %] =
    VAR Valore = [Costo Acquisto]
    VAR Elenco =
        FILTER (
            CALCULATETABLE (
                ADDCOLUMNS ( VALUES ( Articoli[Famiglia] ), "@Valore", [Costo Acquisto] ),
                ALLSELECTED ( Articoli )
            ),
            NOT ISBLANK ( [@Valore] )
        )
    VAR Cumulato = SUMX ( FILTER ( Elenco, [@Valore] >= Valore ), [@Valore] )
    VAR Totale = SUMX ( Elenco, [@Valore] )
    RETURN
        IF ( NOT ISBLANK ( Valore ), DIVIDE ( Cumulato, Totale ) )

[Classe ABC Famiglia] =
    VAR Quota = [Quota Cumulata Famiglia %]
    RETURN
        SWITCH ( TRUE (), ISBLANK ( Quota ), BLANK (), Quota <= 0.80, "A", Quota <= 0.95, "B", "C" )

[Quota Cumulata Fornitore %] =
    VAR Valore = [Costo Acquisto]
    VAR Elenco =
        FILTER (
            CALCULATETABLE (
                ADDCOLUMNS ( VALUES ( Fornitori[Fornitore] ), "@Valore", [Costo Acquisto] ),
                ALLSELECTED ( Fornitori )
            ),
            NOT ISBLANK ( [@Valore] )
        )
    VAR Cumulato = SUMX ( FILTER ( Elenco, [@Valore] >= Valore ), [@Valore] )
    VAR Totale = SUMX ( Elenco, [@Valore] )
    RETURN
        IF ( NOT ISBLANK ( Valore ), DIVIDE ( Cumulato, Totale ) )

[Classe ABC Fornitore] =
    VAR Quota = [Quota Cumulata Fornitore %]
    RETURN
        SWITCH ( TRUE (), ISBLANK ( Quota ), BLANK (), Quota <= 0.80, "A", Quota <= 0.95, "B", "C" )

[Articoli in Classe A] =
    COUNTROWS (
        FILTER ( VALUES ( Articoli[Descrizione] ), [Classe ABC Articolo] = "A" )
    )


-- ==================== 3. Controlli ====================

-- Segnala i casi da verificare con l'ufficio acquisti.
[Stato Confronto Listino] =
    SWITCH (
        TRUE (),
        ISBLANK ( [Costo Acquisto] ), BLANK (),
        ISBLANK ( [Valore a Listino] ), "Listino mancante",
        [Costo Acquisto] > [Valore a Listino], "Costo sopra listino",
        "In linea con il listino"
    )

[Righe senza Listino] =
    CALCULATE ( COUNTROWS ( Acquisti ), ISBLANK ( Acquisti[Listino Totale] ) )

