model Model
	culture: it-IT
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CartellaDati", "Agenti", "Clienti", "Fornitori", "Articoli", "Fatture", "Scadenze"]

ref table Agenti
ref table Clienti
ref table Fornitori
ref table Articoli
ref table Fatture
ref table Scadenze
ref table Calendario
ref table 'Giorni DSO'
ref table _Misure
