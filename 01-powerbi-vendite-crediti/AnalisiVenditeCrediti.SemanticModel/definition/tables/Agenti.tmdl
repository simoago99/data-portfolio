table Agenti
	lineageTag: c9e7f0f0-ae94-5bee-97cc-b2963ac9842e

	column 'Codice Agente'
		dataType: string
		lineageTag: cb6f01e8-2a76-5f8f-8b70-ef1186835515
		summarizeBy: none
		sourceColumn: Codice Agente

		annotation SummarizationSetBy = Automatic

	column Agente
		dataType: string
		lineageTag: 74b384f3-69b5-5919-a9d6-68081aaa6d22
		summarizeBy: none
		sourceColumn: Agente

		annotation SummarizationSetBy = Automatic

	column Area
		dataType: string
		lineageTag: f60220b0-7e9c-5f8f-a1e9-c9919b402eeb
		summarizeBy: none
		sourceColumn: Area

		annotation SummarizationSetBy = Automatic

	partition Agenti = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "agenti.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Codice Agente", type text}, {"Agente", type text}, {"Area", type text}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
