	partition Fatture = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "fatture_righe.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Numero Fattura", type text}, {"Data Fattura", type date}, {"Codice Cliente", type text}, {"Codice Agente", type text}, {"Codice Articolo", type text}, {"Quantita", Int64.Type}, {"Prezzo Listino", Currency.Type}, {"Sconto %", type number}, {"Imponibile", Currency.Type}, {"Valore Omaggio", Currency.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
