	partition Clienti = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "clienti.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Codice Cliente", type text}, {"Ragione Sociale", type text}, {"Provincia", type text}, {"Zona", type text}, {"Canale", type text}, {"Codice Agente", type text}, {"Data Acquisizione", type date}, {"Giorni Pagamento", Int64.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
