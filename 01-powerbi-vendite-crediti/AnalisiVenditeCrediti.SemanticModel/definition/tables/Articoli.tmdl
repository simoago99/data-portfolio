	partition Articoli = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "articoli.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Codice Articolo", type text}, {"Descrizione", type text}, {"Famiglia", type text}, {"Codice Fornitore", type text}, {"Prezzo Listino", Currency.Type}, {"Costo Standard", Currency.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
