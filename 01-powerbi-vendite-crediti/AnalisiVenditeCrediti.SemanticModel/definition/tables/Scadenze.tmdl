	partition Scadenze = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "scadenze.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Numero Fattura", type text}, {"Codice Cliente", type text}, {"Data Fattura", type date}, {"Data Scadenza", type date}, {"Importo", Currency.Type}, {"Data Pagamento", type date}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
