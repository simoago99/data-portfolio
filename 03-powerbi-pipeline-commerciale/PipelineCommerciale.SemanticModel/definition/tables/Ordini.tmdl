	partition Ordini = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "ordini.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Numero Ordine", type text}, {"Data Ordine", type date}, {"ID Trattativa", type text}, {"Codice Cliente", type text}, {"Codice Commerciale", type text}, {"Linea Prodotto", type text}, {"Tipo Ricavo", type text}, {"Valore Ordine", Currency.Type}, {"Data Consegna Prevista", type date}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
