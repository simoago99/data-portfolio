	partition Trattative = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "trattative.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"ID Trattativa", type text}, {"Data Apertura", type date}, {"Data Chiusura", type date}, {"Stato", type text}, {"Motivo Perdita", type text}, {"Codice Cliente", type text}, {"Codice Commerciale", type text}, {"Linea Prodotto", type text}, {"Tipo Ricavo", type text}, {"Valore", Currency.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
