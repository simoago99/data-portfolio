	partition Fatture = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "fatture.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Numero Fattura", type text}, {"Data Fattura", type date}, {"Numero Ordine", type text}, {"Codice Cliente", type text}, {"Linea Prodotto", type text}, {"Tipo Ricavo", type text}, {"Importo", Currency.Type}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
