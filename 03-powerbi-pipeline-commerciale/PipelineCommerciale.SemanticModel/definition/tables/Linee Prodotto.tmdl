table 'Linee Prodotto'
	lineageTag: 74ea1f6f-9def-5763-9bec-319e5234dfd3

	column 'Linea Prodotto'
		dataType: string
		lineageTag: 72f6ac76-8fa2-5d9c-a119-68512f0f6f97
		summarizeBy: none
		sourceColumn: Linea Prodotto

		annotation SummarizationSetBy = Automatic

	column 'Tipo Ricavo'
		dataType: string
		lineageTag: 9cd95cf3-8d63-51d3-aeed-e5f2aea88085
		summarizeBy: none
		sourceColumn: Tipo Ricavo

		annotation SummarizationSetBy = Automatic

	partition 'Linee Prodotto' = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "linee_prodotto.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars = true]),
				    VuotiInNull = Table.ReplaceValue(Intestazioni, "", null, Replacer.ReplaceValue, Table.ColumnNames(Intestazioni)),
				    Tipi = Table.TransformColumnTypes(VuotiInNull, {{"Linea Prodotto", type text}, {"Tipo Ricavo", type text}}, "en-US")
				in
				    Tipi

	annotation PBI_ResultType = Table
